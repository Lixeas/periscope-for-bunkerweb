# Clé de chiffrement des tokens BunkerWeb (OBLIGATOIRE). Génération :
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Sauvegardez-la hors du serveur : sans elle, les tokens enregistrés sont perdus.
PERISCOPE_SECRET_KEY=

# Domaine WebAuthn (passkeys) et origines autorisées (JSON). Mettre TOUTES les URLs d'accès.
PERISCOPE_RP_ID=periscope.example.com
PERISCOPE_ORIGINS=["https://periscope.example.com","http://localhost:8000"]

# true derrière HTTPS (cookies Secure + HSTS). false uniquement pour un essai en HTTP local.
PERISCOPE_COOKIE_SECURE=true

# IP du reverse proxy de confiance, TELLE QUE LE CONTENEUR LA VOIT (pour l'IP cliente dans
# l'audit et l'anti-bruteforce). Voir le README : même machine = passerelle Docker, autre serveur = IP du proxy.
PERISCOPE_TRUSTED_PROXY=127.0.0.1

# Adresse et port sur lesquels Periscope est publié par docker compose.
# 127.0.0.1 = local uniquement. Pour un reverse proxy (même machine ou autre serveur) : IP PRIVÉE de cette machine.
PERISCOPE_BIND=127.0.0.1
PERISCOPE_PORT=8000

# Optionnel
# PERISCOPE_POLL_INTERVAL=30
# PERISCOPE_PROBE_INTERVAL=900
# PERISCOPE_HTTP_TIMEOUT=5
