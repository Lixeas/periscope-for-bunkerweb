# Encryption key for BunkerWeb tokens (REQUIRED). Generate it with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Back it up off the server: without it, the stored tokens are lost.
PERISCOPE_SECRET_KEY=

# WebAuthn domain (passkeys) and allowed origins (JSON). List ALL access URLs.
PERISCOPE_RP_ID=periscope.example.com
PERISCOPE_ORIGINS=["https://periscope.example.com","http://localhost:8000"]

# true behind HTTPS (Secure cookies + HSTS). false only for a trial over local HTTP.
PERISCOPE_COOKIE_SECURE=true

# IP of the trusted reverse proxy, AS THE CONTAINER SEES IT (used for the client IP in the
# audit log and brute-force protection). See the README: same machine = Docker gateway, other server = proxy IP.
PERISCOPE_TRUSTED_PROXY=127.0.0.1

# Address and port on which docker compose publishes Periscope.
# 127.0.0.1 = local only. For a reverse proxy (same machine or another server): this machine's PRIVATE IP.
PERISCOPE_BIND=127.0.0.1
PERISCOPE_PORT=8000

# Optional
# PERISCOPE_POLL_INTERVAL=30
# PERISCOPE_PROBE_INTERVAL=900
# PERISCOPE_HTTP_TIMEOUT=5
